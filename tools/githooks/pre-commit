#!/usr/bin/env bash
# Four checks before every commit:
#   1. Block a commit whose staged changes or commit message contain a
#      private term. Term list: .gitprivacy-terms (gitignored -- one
#      whole-word term per line, '#' comments, case-insensitive).
#   2. Strip AI-attribution lines (Co-Authored-By: Claude, "Generated with
#      Claude Code", etc.) from staged file content -- this repo never
#      carries attribution, see CLAUDE.md. Commit-message attribution is
#      handled separately by the commit-msg hook (message files aren't
#      staged, so this hook never sees them).
#   3. Unstage any staged GIF unconditionally, and any other staged image
#      file outside docs/ -- no GIFs (replay/training footage) ever get
#      committed anywhere in the repo (see CLAUDE.md); docs/ is the one
#      place real images (hardware photos, diagrams we make) belong.
#   4. Doc checks (tools/check_docs.py): broken relative links, hard-coded test counts or the deployed
#      policy name in the wrong page, a stale generated docs/backlog.md.
#   5. Commit hygiene: BLOCK a commit that adds more than 150 files or any file over 5 MB (override: G2_ALLOW_BIG_COMMIT=1), and WARN
#      about leftover untracked files / scratch (tools/g2_cleanup.py) so they get committed by exact path or deleted.
# Activate once per clone:  git config core.hooksPath tools/githooks
# Bypass a genuine false positive:  git commit --no-verify
set -u

# --- 2. strip attribution from staged file content ---------------------
# Excludes tools/githooks/* -- this pattern definition necessarily contains
# the words it's matching against, so scanning the hooks themselves would
# self-match (same reason the privacy-term check below excludes itself).
attribution_pattern='Co-Authored-By:.*([Cc]laude|[Aa]nthropic)|Generated with \[?Claude Code|🤖 Generated with'
staged_files="$(git diff --cached --name-only --diff-filter=ACM -- . ':(exclude)tools/githooks/*')"
if [ -n "$staged_files" ]; then
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    if grep -qE "$attribution_pattern" "$f" 2>/dev/null; then
      grep -vE "$attribution_pattern" "$f" > "$f.tmp" && mv "$f.tmp" "$f"
      git add -- "$f"
      echo "pre-commit: stripped an attribution line from $f"
    fi
  done <<< "$staged_files"
fi

# --- 3. unstage GIFs (always) and other images outside docs/ -----------
gif_pattern='\.gif$'
staged_gifs="$(git diff --cached --name-only --diff-filter=ACM | grep -iE "$gif_pattern" || true)"
if [ -n "$staged_gifs" ]; then
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    git reset -q -- "$f"
    echo "pre-commit: unstaged GIF (never committed, anywhere): $f"
  done <<< "$staged_gifs"
fi

image_pattern='\.(png|jpg|jpeg|webp|bmp)$'
staged_images="$(git diff --cached --name-only --diff-filter=ACM \
  | grep -iE "$image_pattern" | grep -v '^docs/' || true)"
if [ -n "$staged_images" ]; then
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    git reset -q -- "$f"
    echo "pre-commit: unstaged image file (not under docs/): $f"
  done <<< "$staged_images"
fi

# --- 4. doc checks: broken links, volatile facts in the wrong page, a stale generated backlog ------
# Runs when Markdown (or a doc-check input) is staged. If DEFAULT_POLICY changed, check every page, since the new policy name
# may already be sitting in a page that is not staged. Details: tools/check_docs.py, docs/README.md "Where to update what".
# Bypass a genuine false positive:  git commit --no-verify
staged_all="$(git diff --cached --name-only --diff-filter=ACM)"
if printf '%s\n' "$staged_all" | grep -qE '\.md$|^tools/(check_docs|gen_backlog)\.py$|^pi_pipeline/gait/residual_policy\.py$'; then
  doc_mode="--staged"
  printf '%s\n' "$staged_all" | grep -qE '^pi_pipeline/gait/residual_policy\.py$' && doc_mode=""
  if ! python3 "$(git rev-parse --show-toplevel)/tools/check_docs.py" $doc_mode --quiet-warnings; then
    echo "pre-commit: doc checks failed (ERROR lines above). Fix them, or bypass with --no-verify."
    exit 1
  fi
fi

# --- 5. commit hygiene: no mass adds, no big files; remind about leftovers -----------------------------
# (the 2026-10-09 accident: `git add` on a folder pushed 2,074 training outputs.) Override a deliberate big commit with G2_ALLOW_BIG_COMMIT=1.
if [ "${G2_ALLOW_BIG_COMMIT:-0}" != 1 ]; then
  added="$(git diff --cached --name-only --diff-filter=A)"
  n_added=0; [ -n "$added" ] && n_added=$(printf '%s\n' "$added" | wc -l | tr -d ' ')
  if [ "$n_added" -gt 150 ]; then
    echo "pre-commit: this commit ADDS $n_added files (limit 150): was a whole folder added by mistake? Add by exact path, or G2_ALLOW_BIG_COMMIT=1 git commit ..."
    exit 1
  fi
  big=""
  while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] || continue
    sz=$(wc -c < "$f" | tr -d ' ')
    [ "$sz" -gt 5242880 ] && big="$big\n  $f ($((sz / 1048576)) MB)"
  done <<< "$added"
  if [ -n "$big" ]; then
    printf "pre-commit: file(s) over 5 MB would be added:$big\nTraining outputs do not belong in the repo. Override: G2_ALLOW_BIG_COMMIT=1 git commit ...\n"
    exit 1
  fi
fi
left="$(python3 "$(git rev-parse --show-toplevel)/tools/g2_cleanup.py" --check 2>/dev/null || true)"
[ -n "$left" ] && echo "pre-commit: $left"

repo_root="$(git rev-parse --show-toplevel)"
terms_file="$repo_root/.gitprivacy-terms"
[ -f "$terms_file" ] || exit 0   # no term list -> nothing to enforce

# build an alternation of whole-word patterns from non-comment, non-blank lines
pattern="$(grep -vE '^\s*(#|$)' "$terms_file" \
  | sed -E 's/[][\.^$*+?(){}|]/\\&/g' \
  | paste -sd'|' - )"
[ -n "$pattern" ] || exit 0

hits=0

# strip known-safe compounds so a listed first name does not fire on unrelated
# identifiers: pytest m.a.r.k, bench___, book___, ___down/___er/___up/___et, etc.
safe_scrub() { sed -E "s/(pytest\.mark|benchmark|bookmark|mark(down|er|up|et|s)|[a-z]-mark|re-?mark|land-?mark|water-?mark|hall-?mark|ear-?mark)//gi"; }

# scan staged additions, but not this hook / the term list themselves
staged="$(git diff --cached --unified=0 --no-color -- . ':(exclude)tools/githooks/*' \
  | grep -E '^\+' | grep -vE '^\+\+\+' | safe_scrub || true)"
if printf '%s' "$staged" | grep -iEnw "$pattern" >/dev/null 2>&1; then
  echo "pre-commit: a private term appears in the staged changes:"
  printf '%s\n' "$staged" | grep -iEnw --color=always "$pattern" | sed 's/^/  /'
  hits=1
fi

msg_file="${1:-}"
if [ -n "$msg_file" ] && [ -f "$msg_file" ]; then
  if safe_scrub < "$msg_file" | grep -iEw "$pattern" >/dev/null 2>&1; then
    echo "pre-commit: a private term appears in the commit message."
    hits=1
  fi
fi

if [ "$hits" -ne 0 ]; then
  echo
  echo "Reword to a role/placeholder, or --no-verify if it is truly a false positive."
  exit 1
fi
exit 0
