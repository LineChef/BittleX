#!/usr/bin/env bash
# Keep the local, outside-the-repo CLAUDE.md backup fresh: after every commit,
# if CLAUDE.md exists in the working tree, copy it to ~/.local/share/g2/. That
# path never touches git (it's outside the repo entirely), so this can't leak
# CLAUDE.md's content into the public repo -- it only ever writes to disk on
# this machine.
# Activate once per clone:  git config core.hooksPath tools/githooks
set -u

src="$(git rev-parse --show-toplevel)/CLAUDE.md"
backup_dir="$HOME/.local/share/g2"

if [ -f "$src" ]; then
  mkdir -p "$backup_dir"
  cp "$src" "$backup_dir/CLAUDE.md.backup"
fi

# Also keep the other local, gitignored Claude Code files backed up (skills, path-scoped rules, settings), copied beside
# the CLAUDE.md backup into one folder; same reason: outside the repo, never tracked.
root="$(git rev-parse --show-toplevel)"
cfg="$backup_dir/claude-config-backup"
if [ -d "$root/.claude" ]; then
  mkdir -p "$cfg"
  [ -f "$src" ] && cp "$src" "$cfg/CLAUDE.md"
  [ -f "$root/.claude/settings.json" ] && cp "$root/.claude/settings.json" "$cfg/settings.json"
  [ -d "$root/.claude/skills" ] && rsync -a --delete "$root/.claude/skills/" "$cfg/skills/"
  [ -d "$root/.claude/rules" ] && rsync -a --delete "$root/.claude/rules/" "$cfg/rules/"
fi
exit 0
