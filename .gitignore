# Secrets — never commit these
.env
*.env
config.local.*
**/secrets.py
**/api_keys.py

# Python
__pycache__/
*.pyc
*.pyo
venv/
env/
.venv/
*.egg-info/

# Trained model checkpoints (large binary files — consider Git LFS if you want to version these)
*.zip
*.pkl
rl_training/models/
rl_training/logs/
**/tensorboard_logs/

# OS/editor cruft
.DS_Store
.vscode/
.idea/
*.swp

# Local data / memory DB (personal conversation history — don't commit).
# The DB now defaults to ~/.local/share/g2/ (outside the repo); these are a backstop.
*.db
*.sqlite
*.sqlite3
pi_pipeline/memory/data/

# Personal media / training data — photos of people, pets, the home (B15 model
# training). Put ALL such media under one of these dirs; never commit it.
training_data/
datasets/
**/faces/
**/household/
**/media_local/
*.jpg
*.jpeg
*.mp4
*.mov

# Run console logs
*.log

# Automated-iteration scratch
rl_training/opencat-gym/eval_frames/
rl_training/opencat-gym/STOP
rl_training/opencat-gym/frames_wkf/

# Claude Code project config lives at user level (~/.claude/), not in the repo
.claude/
CLAUDE.md
CLAUDE.local.md

# Downloaded STT/TTS models (Vosk, Piper) -- large, not versioned
models/
rl_training/opencat-gym/*.gif
rl_training/opencat-gym/benchmark_*.gif

# Pre-commit privacy denylist. Enable the hook per clone:
#   git config core.hooksPath .githooks
.gitprivacy-terms
