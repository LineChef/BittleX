# Copy this file to .env (at the repo root) and fill in real values.
# .env is gitignored -- never commit it.

# --- Phase 7: Voice + Claude ---
# Required. Usage-billed, separate from any Claude subscription.
ANTHROPIC_API_KEY=
# The console expiry date you set on the key, as YYYY-MM-DD. G2 warns as it
# nears and says so clearly once past -- so an expired key is never a silent
# "why won't it answer". Empty = no check.
# ANTHROPIC_API_KEY_EXPIRES=2027-09-10
# G2_API_KEY_EXPIRY_WARN_DAYS=30

# What G2 says out loud when a Claude call fails for a KNOWN reason (instead of
# the generic "I glitched"). Reword in character if you like.
# G2_SPEECH_API_AUTH=I can't reach my brain right now -- my API key may be invalid or expired.
# G2_SPEECH_API_RATE=I'm being rate-limited. Give me a moment and try again.
# G2_SPEECH_API_BILLING=I've hit my usage limit and can't chat right now.

# Optional -- these have sensible defaults (see pi_pipeline/config.py)
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_MAX_TOKENS=400
# G2_CLAUDE_EFFORT=low           # thinking depth: low | medium | high | xhigh | max; empty = model default
# CLAUDE_TIMEOUT_S=30
# --- Swappable LLM (docs/guides/swappable-llm.md) ---
# G2_LLM_MODE=claude          # claude (default) | fast (OpenAI-style backend only) | routed (fast for casual turns, Claude for the rest)
# G2_FAST_LLM_BASE_URL=       # e.g. https://<provider>/v1  (must serve POST /chat/completions with tool calls)
# G2_FAST_LLM_API_KEY=
# G2_FAST_LLM_MODEL=
# G2_FAST_LLM_SEES_MEMORY=0   # 1 = also send recalled memory to the fast backend (default: those turns go to Claude)
# G2_ROUTE_MAX_WORDS=25       # longer requests go to Claude in routed mode
# G2_ROUTE_ESCALATE_PATTERN=  # regex; matching turns go to Claude (default list in voice/llm.py)
# G2_HISTORY_TURNS=12
# G2_FEATURES=                # staged bring-up; empty = all on. e.g.
#                            #   profile:p2-gait   |   -explore, gait:scripted
#                            # `python -m pi_pipeline --profiles` lists the stages
# G2_SYSTEM_PROMPT=          # override G2's persona/instructions
# G2_WAKE_WORD=gee two, hey buddy, hey bud   # comma-separated, any one wakes G2 --
#                            # spell each how Vosk hears it, not "G2"
# VOSK_MODEL_PATH=models/vosk
# PIPER_MODEL_PATH=models/piper/en_US-ryan-low.onnx   # default (Pi Zero 2 W-safe).
#                            # On a dev machine, point this at a 'medium' voice
#                            # (e.g. en_GB-alan-medium) for nicer audio.
# G2_QUESTION_WINDOW_S=8      # after G2 asks a question, listen this long for the answer without the wake word (0 = never)
# G2_STT_SILENCE_S=0.5         # how long the transcript must stop changing to end your turn (0.25 s steps); lower = snappier, cuts off pauses
# G2_BATTERY_LOW_V=7.2        # G2's 2S pack, volts: siren + "My battery is low" (7.2 V is about 20%)
# G2_PI_BATTERY_WATCH=1      # warn at 80% of the Pi runtime measured by a timed test (silent until one completes; 0 = off)
# G2_PI_BATTERY_ARM=boot      # boot (default): count Pi battery time from boot; manual: only after you say "you're unplugged"
# G2_PI_FULL_RUNTIME_S=0      # the Pi's runtime per charge in seconds; 0 = average of the runs logged automatically
# G2_BALANCE_OFF_IDLE=1       # keep firmware gyro balance off while G2 is idle (on only around a firmware gait); 0 = leave it to the firmware
# G2_STAND_GUARD=1            # watch the IMU and turn balance off if a standing wobble starts
# G2_VISION_DESCRIBE=1       # attach a camera picture when asked "what do you see" (never saved; needs +vision in G2_FEATURES)
# G2_VISION_SAVE_DIR=        # opt-in: keep every camera picture in this folder (default: never save). For collecting a test set
# G2_TIDY_DAYS=30            # at start, delete ~/g2_logs session folders and ~/g2_runs files older than this (0 = never)
# G2_EXPOSURE_CHECK=1        # re-take a look picture in better light when it is blown out or too dark (adapts to the room)
# G2_PICTURE_KEEP_DAYS=7     # pictures kept by G2_VISION_SAVE_DIR are deleted after this many days (0 = keep forever)
# G2_CAPTURE_KEEP_S=3600     # the start-up clear of ~/g2_cap skips anything touched in the last this-many seconds
# G2_CLEAR_CAPTURES=1        # delete the camera preview's captures (~/g2_cap) at every voice-service start: pull them first (g2pcam-pull)
# G2_MEMORY_USE_LOG=match     # which memory shaped replies: match (free, default) | declare (G2 names the notes; costs extra API calls) | off
# G2_MEMORY_CORE_MAX=12      # identity-level (core) facts always injected, never rotated out
# G2_OBSERVATION_DAYS=30     # keep what G2 saw (text only) this long
# G2_CONSOLIDATE=1           # idle-time memory tidy-up (merge duplicates, drop trivia, a few 'It seems' reflections); see memory/README.md
# G2_CONSOLIDATE_IDLE_S=1200 # ...after this many seconds idle (or when told to sleep)
# G2_CONSOLIDATE_MIN_EXCHANGES=6      # ...and at least this many new exchanges since the last pass
# G2_CONSOLIDATE_MIN_INTERVAL_S=21600 # ...at most one pass this often per service run
# G2_CAMERA_SOUNDS=1         # shutter chirp per picture; rising chirp (+ reminder) while the vision feed runs; falling chirp when it stops
# G2_CAMERA_PEAK=0.045       # camera sound loudness (10% of 0.45)
# G2_CAMERA_REMINDER_S=60    # seconds between reminders while continuous capture runs (0 = none)
# G2_ACK_TONE=short_tone         # short_tone (one short blip through the speaker, default) | star_trek_whistle | buzzer (old low blip) | off
# G2_ACK_PEAK=0.0225            # acknowledgement loudness, fraction of full scale (5% of 0.45)
# G2_ALERT_PEAK=0.045            # battery alert loudness (10% of 0.45)
# G2_CUE_STAGES=thinking      # which stages beep: listening, thinking (a command going to Claude), heard (a local command)
# G2_BUZZER_VOLUME=10         # buzzer volume 1-10 sent at start (0 = leave the board's setting)
# G2_BUZZER_SHIFT=0           # voice cue beeps: raise notes by this many semitones
# G2_BUZZER_LEN=1.0           # ...and make each note this many times longer (the firmware duration is 1/N s, so the token number shrinks)
# G2_API_KEEPALIVE_S=300      # keep the Claude API connection open this long between turns (SDK default 5)
# G2_API_WARMUP=1             # open that connection in the background when the wake word is heard (0 = off)
# G2_STREAM=1                 # stream Claude's reply (speak sentence by sentence, move the moment a skill call is complete); 0 = off
# G2_DISK_WARN_PCT=85         # warn in the log when the SD card is this percent full or more
# G2_VOICE_STYLE=metal        # robot voice: plain | current | dalek | monotone | metal | retro | deep
# G2_TTS=print                # voice-loop speech: auto | mac | piper | print. `print` on a Pi with no speaker yet
# G2_MAX_GAIT_S=5             # auto-stop a voice-started walk/trot/crawl after this many seconds (unset/0 = off)
# G2_FOLLOW_UP_S=60           # keep listening this long after a reply before the
#                            # wake word is needed again (resets each exchange);
#                            # large = awake until "go to sleep"; 0 = every turn

# --- Raspberry Pi Zero 2 W overrides (put these in the Pi's .env) ---
# The default en_US-ryan-low voice is already the light one. Run
# `pi_pipeline/benchmark_pi.py --all-voices` on the Pi; move up to
# en_US-ryan-medium only if its synth stays comfortably under real-time.
# Models: run  bash pi_pipeline/fetch_models.sh

# --- Phase 9: Memory ---
# G2_MEMORY=1                                        # 0 to disable persistent memory
# The DB holds names / preferences / conversation history -- keep it OUT of the
# repo and out of any cloud-synced folder. Default is ~/.local/share/g2/ ('~'
# expands); override only to another path outside a synced tree.
# G2_MEMORY_DB=~/.local/share/g2/g2_memory.db
# G2_MEMORY_MAX_FACTS=30
# G2_MEMORY_RECALL=3

# --- Robot serial link (used only with --actuator serial, on hardware) ---
# G2_SERIAL_PORT=/dev/serial0        # primary UART; = ttyAMA0 after disable-bt (setup_pi.sh)
# G2_SERIAL_BAUD=115200

# --- Phase 8: Vision (hardware) ---
# VISION_SERIAL_PORT=/dev/ttyACM0
# VISION_SERIAL_BAUD=921600
# VISION_SENSOR_OPT=1        # sensor capture: 0=240  1=480  2=640x480 (1 = cleaner)
# VISION_AE_BUMP=32          # auto-exposure lift for dim rooms; 0=off, ~48 aggressive
# VISION_MIN_SCORE=0         # drop detections below this score (0-100); raise if a model over-fires
# VISION_FRAME_PX=240                 # model input size, for coord normalisation
# VISION_LABELS=cable,cup,shoe        # deployed model's class names, id order

# --- Personality (pi_pipeline/personality) ---
# Traits that bias G2's prompt / autonomous behaviour / cues. name=level, 0..1.
# G2_TRAITS=curiosity=0.8, playfulness=0.4
#
# Opt-in "character mode" -- OFF by default, turn on when you want it:
# G2_CHARACTER=gir            # chaotic-little-robot manner (pastiche, no show quotes)
# G2_CHARACTER_LEVEL=0.4      # 0..1 intensity (default 0.4). An explicit
#                             #   gir=<level> in G2_TRAITS overrides this.
#
# Household roster for B15 recognition/bonds -- PERSONAL DATA, real values live
# only here in the gitignored .env. Names must match the vision model's class
# labels. Format: name:closeness:disposition[:kind], ';'-separated.
#   closeness   0.0-1.0
#   disposition affectionate | playful | curious | wary | fearful | neutral
#   kind        person | pet   (optional, default person)
# G2_BONDS=self:1.0:affectionate; partner:0.95:affectionate; kiddo:0.9:playful; rex:0.5:wary:pet
